# =============================================================================
# Vanguard Skin — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
#
# Required variables are needed for core functionality.
# Optional variables enable additional features.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Anthropic API key for Claude AI (PDF parsing + chat interface)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# -----------------------------------------------------------------------------
# OPTIONAL — Database location override
# -----------------------------------------------------------------------------

# Full path to vanguard.db. When set, overrides the default `<cwd>/data/vanguard.db`.
# Use case: running audit/migration scripts from a git worktree against the main
# repo's live DB without copying. Example:
#   DATABASE_PATH=$HOME/code/vanguard-skin/data/vanguard.db npx tsx scripts/audit-twr-vs-statements.ts
# DATABASE_PATH=

# Alternative: override just the directory (full filename stays vanguard.db).
# Honored only when DATABASE_PATH is unset. Back-compat with older scripts.
# VANGUARD_DB_DIR=

# -----------------------------------------------------------------------------
# IBKR TWS (required for live data features)
# -----------------------------------------------------------------------------

# Your personal IBKR account code (e.g., U12345678)
# Found in TWS under Account > Account Information
IBKR_ACCOUNT_CODE=UXXXXXXXX

# -----------------------------------------------------------------------------
# OPTIONAL — Calendar & Research
# -----------------------------------------------------------------------------

# FRED API key for economic calendar data (FOMC, CPI, jobs reports)
# Free — register at: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=your-fred-api-key

# SEC EDGAR contact email (required by SEC fair access policy for API calls)
# EDGAR_CONTACT_EMAIL=your-email@example.com

# API Ninjas key for earnings transcripts (premium plan required, $39+/mo)
# https://api-ninjas.com/
# API_NINJAS_API_KEY=your-api-ninjas-key

# Alpha Vantage key for earnings call transcripts (free key at alphavantage.co, 25 req/day)
ALPHA_VANTAGE_API_KEY=

# Finnhub API key for per-held-stock earnings dates + analyst estimates
# Free — register at: https://finnhub.io/
# FINNHUB_API_KEY=your-finnhub-key

# -----------------------------------------------------------------------------
# OPTIONAL — Inbound email (newsletter ingestion from your Gmail inbox)
# -----------------------------------------------------------------------------

# Gmail IMAP credentials (App Password, not your regular password)
# Used for IMAP-only newsletter sources. See: https://support.google.com/accounts/answer/185833
# GMAIL_ADDRESS=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-gmail-app-password

# Google OAuth 2.0 credentials for reading Gmail newsletters (Research Feeds)
# Set up a Google Cloud project with Gmail API enabled, then run:
#   npx tsx scripts/gmail-oauth-setup.ts
# for a guided OAuth setup flow that generates the refresh token.
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REFRESH_TOKEN=generated-by-scripts/gmail-oauth-setup.ts

# Address that forwarded emails become research documents at.
# Requires an email-routing rule delivering this address into the Gmail inbox above.
# RESEARCH_INBOX_ADDRESS=read@yourdomain.com

# -----------------------------------------------------------------------------
# OPTIONAL — Outbound email via Resend (briefings, digests, earnings emails)
# -----------------------------------------------------------------------------

# Resend API key + verified sending domain. Free tier is sufficient.
# https://resend.com/
# RESEND_API_KEY=your-resend-key
# RESEND_FROM_DOMAIN=yourdomain.com
# REPLY_TO_ADDRESS=you@example.com
# BRIEFING_EMAIL_TO=recipient@example.com

# -----------------------------------------------------------------------------
# OPTIONAL — Mobile push (Pushover)
# -----------------------------------------------------------------------------

# Level alerts + earnings prints pushed to your phone.
# https://pushover.net/ (one-time ~$5 mobile app purchase)
# PUSHOVER_APP_TOKEN=your-pushover-app-token
# PUSHOVER_USER_KEY=your-pushover-user-key
# Base URL used in notification deep links (e.g. your mesh/LAN address)
# PUSHOVER_LINK_BASE=http://localhost:3000

# -----------------------------------------------------------------------------
# OPTIONAL — IBKR Web API (headless OAuth — refresh holdings without TWS)
# -----------------------------------------------------------------------------

# Directory containing IBKR first-party OAuth 1.0a credentials
# (consumer key, PKCS8 signature/encryption keys, access token).
# IBKR_OAUTH_DIR=/path/to/ibkr-oauth

# -----------------------------------------------------------------------------
# OPTIONAL — Cloudflare (AI cost tracking, cloud fallback, backups)
# -----------------------------------------------------------------------------

# AI Gateway: routes Claude calls through your gateway for per-feature cost
# tracking. Missing values transparently fall back to direct provider URLs.
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_GATEWAY_ID=your-gateway-id
# CLOUDFLARE_WORKERS_AI_TOKEN=your-workers-ai-token

# R2 statement archival (disaster-recovery backup of imported PDFs)
# R2_BUCKET_NAME=your-bucket
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret
# R2_ACCOUNT_ID=falls-back-to-CLOUDFLARE_ACCOUNT_ID

# Worker cron hybrid: lets a Cloudflare Worker send emails / scan levels
# when this machine is asleep, with shared dedup markers. See workers/cron/.
# CRON_SHARED_SECRET=any-long-random-string-shared-with-the-worker
# WORKER_MARKER_URL=https://your-worker.workers.dev
# WORKER_GMAIL_CLIENT_ID=oauth-client-for-worker-gmail-access
# WORKER_GMAIL_CLIENT_SECRET=oauth-secret-for-worker-gmail-access
