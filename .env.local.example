# =============================================================================
# Vanguard Skin — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
#
# Required variables are needed for core functionality.
# Optional variables enable additional features.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Anthropic API key for Claude AI (PDF parsing + chat interface)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# -----------------------------------------------------------------------------
# IBKR TWS (required for live data features)
# -----------------------------------------------------------------------------

# Your personal IBKR account code (e.g., U12345678)
# Found in TWS under Account > Account Information
IBKR_ACCOUNT_CODE=UXXXXXXXX

# -----------------------------------------------------------------------------
# OPTIONAL — Calendar & Research
# -----------------------------------------------------------------------------

# FRED API key for economic calendar data (FOMC, CPI, jobs reports)
# Free — register at: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=your-fred-api-key

# SEC EDGAR contact email (required by SEC fair access policy for API calls)
# EDGAR_CONTACT_EMAIL=your-email@example.com

# API Ninjas key for earnings transcripts (premium plan required, $39+/mo)
# https://api-ninjas.com/
# API_NINJAS_API_KEY=your-api-ninjas-key

# -----------------------------------------------------------------------------
# OPTIONAL — Email Briefings
# -----------------------------------------------------------------------------

# Gmail credentials for sending automated weekly briefings
# Uses Gmail App Password (not your regular password)
# See: https://support.google.com/accounts/answer/185833
# GMAIL_ADDRESS=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-gmail-app-password
# BRIEFING_EMAIL_TO=recipient@example.com
