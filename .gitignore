# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results

# next.js
/.next/
/out/

# production (keep build/icon.icns and entitlements for Electron)
/build/*
!/build/icon.icns
!/build/entitlements.mac.plist

# electron
/dist-electron
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# project data (root only — don't catch lib/data/)
/data/
tests/fixtures/real/

# claude code (local state)
.claude/worktrees/
.claude/agent-memory/
.superpowers/

# local machine configs (contain absolute paths)
.mcp.json
scripts/launch-dashboard.sh
scripts/VanguardDashboard.applescript
scripts/reimport-holdings.ts
scripts/capture-screenshots.mjs

# typescript
*.tsbuildinfo
next-env.d.ts
