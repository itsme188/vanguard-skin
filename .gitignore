# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results

# next.js
/.next/
/out/

# production (keep build/icon.icns and entitlements for Electron)
/build/*
!/build/icon.icns
!/build/entitlements.mac.plist

# electron
/dist-electron
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# project data (root only — don't catch lib/data/)
/data/
tests/fixtures/real/

# claude code (local state)
.claude/worktrees/
.claude/agent-memory/
.superpowers/

# local machine configs (contain absolute paths)
.mcp.json
scripts/launch-dashboard.sh
scripts/VanguardDashboard.applescript
scripts/reimport-holdings.ts
scripts/capture-screenshots.mjs

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/scheduled_tasks.lock

# playwright + manual screenshot artifacts at repo root
# (often contain real portfolio data — README screenshots live in docs/screenshots/)
# Catch-all: NO root-level PNG is ever committable. Legit screenshots live under
# docs/screenshots/ (a subdirectory, unaffected by this anchored rule). The
# specific prefixes below are kept for documentation but /*.png supersedes them
# — added 2026-06-16 after two un-ignored root captures (today-full-page.png)
# slipped past the prefix list.
.playwright-mcp/
/*.png
/*.jpg
/*.jpeg
/sweep-*.png
/verify-*.png
/phase5-*.png
/dark-*.png
/addlevel-*.png
/cmdk-*.png
/skip-*.png
/earnings-hub-*.png
/transcripts-*.png
/app-bottom-*.png
/ter-transcripts-*.png

# playwright accessibility-tree snapshots dumped at repo root during interactive
# QA (browser_snapshot with a bare `page-name.md` target). Same catch-all logic
# as /*.png above — NO root-level .md is committable except the four real docs
# whitelisted below. Added 2026-07-01 after 22 QA snapshot dumps (~1.6MB) piled
# up in the root. New top-level docs need `git add -f` (rare by design).
/*.md
!/README.md
!/CLAUDE.md
!/AGENTS.md
!/CHANGELOG.md

# Private local-only docs (real financial figures) — never commit
docs/private/
