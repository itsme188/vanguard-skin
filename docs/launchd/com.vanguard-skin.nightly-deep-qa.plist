<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.vanguard-skin.nightly-deep-qa</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/Yitzi/code/vanguard-skin/qa/nightly-deep-qa.sh</string>
	</array>
	<!-- Every 5 min; the script self-gates to once per local day in the
	     02:45-07:00 window. Do NOT use StartCalendarInterval: launchd
	     evaluates it in the timezone cached at boot (fired at 19:45 ET
	     while "scheduled" for 02:45 after a boot in Israel, 2026-06-11). -->
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/Yitzi/Library/Logs/vanguard-nightly-deep-qa.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/Yitzi/Library/Logs/vanguard-nightly-deep-qa.log</string>
</dict>
</plist>
