<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vanguard-skin.evening-email</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/Yitzi/code/vanguard-skin/scripts/send-evening-email.sh</string>
  </array>
  <key>StandardErrorPath</key>
  <string>/Users/Yitzi/Library/Logs/vanguard-evening-email.log</string>
  <key>StandardOutPath</key>
  <string>/Users/Yitzi/Library/Logs/vanguard-evening-email.log</string>
  <!-- Fire every 5 min. Wrapper self-gates to Mon-Thu 19:00-19:10 ET OR
       Fri 17:30-17:40 ET via scripts/lib/et-gate.sh — exits cheaply outside
       window. We can't use StartCalendarInterval because launchd reads
       system local time, which is wrong when the Mac travels. -->
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
